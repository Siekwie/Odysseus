{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5"
  },
  "permissions": {
    "allow": [
      "Bash(odin check *)",
      "Bash(odin build *)",
      "Bash(odin test *)",
      "Bash(odin version)",
      "Bash(./build.sh *)",
      "PowerShell(.\\build.ps1 *)"
    ]
  }
}
